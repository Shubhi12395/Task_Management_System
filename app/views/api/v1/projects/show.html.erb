<h1>Project</h1>

<table>
  <thead>
    <tr>
      <th>Name</th>
      <th>Description</th>
      <th>Status</th>
      <th>Due_date</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
      <tr>
        <td><%= @project.name %></td>
        <td><%= @project.description %></td>
        <td><%= @project.status %></td>
        <td><%= @project.due_date %></td>
      </tr>
  </tbody>
</table>
<br>
<%= button_to "Edit Project", "/api/v1/projects/#{@project.id}/edit", method: :get,  data: { turbo: false } %>

