<h1>Login</h1>
<%= form_with(url: "/api/v1/auth/login", method: :post, local: true) do |form| %>
  <div>
    <%= form.label :email %>
    <%= form.email_field :email %> 
  </div>
  <br>
  <div>
    <%= form.label :password %>
    <%= form.password_field :password %> 
  </div>
  <br>
  <div>
    <%= form.submit "Login" %>
  </div>
<% end %>

