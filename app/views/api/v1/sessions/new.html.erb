<h1>Login</h1>
<%= form_with(url: "/api/v1/auth/login", method: :post, local: true) do |form| %>
  <div>
    <%= form.label :email %>
    <%= form.email_field :email %> 
  </div>
  <div>
    <%= form.label :password %>
    <%= form.password_field :password %> 
  </div>
  <div>
    <%= form.submit "Login" %>
  </div>
<% end %>
<%= button_to "Log Out", api_v1_logout_path, method: :delete, data: { turbo: false } %>

