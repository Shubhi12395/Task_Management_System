<h1>Change Password</h1>

<%= form_with(url: "/api/v1/auth/password_reset", method: :patch, local: true, data: { turbo: false }) do |form| %>
  <div>
    <%= form.label "user[current_password]", "Current Password" %>
    <%= form.password_field "user[current_password]", required: true %>
    </div>
    <br>
    <div>
    <%= form.label "user[new_password]", "New Password" %>
    <%= form.password_field "user[new_password]", required: true %>
    <br>
    <br>
    <div>
    <%= form.submit "Change Password" %>
  </div>
    
    <% end %>
        