<h1>Login</h1>
<%= form_with url: "/api/v1/auth/login", method: :post do |form| %>
  <div>
    <%= form.label :email %>
    <%= form.email_field :email %> 
  </div>
  <div>
    <%= form.label :password %>
    <%= form.password_field :password %> 
  </div>
  <div>
    <%= form.submit "login" %>
  </div>
<% end %>
