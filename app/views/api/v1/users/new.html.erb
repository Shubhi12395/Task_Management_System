<h1>Sign UP</h1>
<%= form_with(model: @user, url: "/api/v1/auth/signup", method: :post, local: true) do |form| %>
  <div> 
    <%= form.label :name %>
    <%= form.text_field :name %>
  </div>
  <br>
  <div>
    <%= form.label :email %>
    <%= form.email_field :email %> 
  </div>
  <br>
  <div>
    <%= form.label :password %>
    <%= form.password_field :password %> 
  </div>
  <br>
  <div>
    <%= form.submit "Create signup" %>
  </div>
<% end %>
