


<h1>Tasks</h1>

<%= form_with url: api_v1_tasks_path, method: :delete, data: { turbo: false } do |form| %>
  <table>
    <thead>
      <tr>
        <th>Select</th> 
        <th>Title</th>
        <th>Description</th>
        <th>Project_id</th>
        <th>Priority</th>
        <th>Status</th>
        <th>Assignee</th>
        <th>Completed_at</th>
        <th>Due_date</th>
        <th>Parent_id</th>
        <th colspan="1"></th>
      </tr>
    </thead>

    <tbody>
      <% @tasks.each do |task| %>
        <tr>
          <td><%= check_box_tag "ids[]", task.id, false, class: "task-checkbox" %></td>
          <td><b><%= link_to task.title, "/api/v1/tasks/#{task.id}" %></b></td>
          <td><%= task.description %></td>
          <td><%= task.project&.name %></td>
          <td><%= task.priority %></td>
          <td><%= task.status %></td>
          <td><%= task.assignee&.name %></td>
          <td><%= task.completed_at %></td>
          <td><%= task.due_date %></td>
          <td><%= task.parent_id %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <br>
  <%= form.submit "Delete Selected Tasks" %>
<% end %>

<div style="position: absolute; top: 65px; right: 15px;">
  <h3>Filters</h3>
  <b>
    <%= link_to "Overdue Tasks", api_v1_tasks_path(status: "overdue") %>
    <br>
    <%= link_to "Due Today Tasks", api_v1_tasks_path(status: "duetoday") %>
    <br>
    <%= link_to "Pending Tasks", api_v1_tasks_path(status: "pending") %>
    <br>
    <%= link_to "Tasks by priority", api_v1_tasks_path(status: "by_priority") %>
  </b>
</div>

<br>
<%= button_to "create task", api_v1_tasks_path, method: :post, data: { turbo: false } %>
