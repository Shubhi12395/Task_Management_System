<h1>Task</h1>

<table>
  <thead>
    <tr>
      <th>Title</th>
      <th>Description</th>
      <th>Project_id</th>
      <th>Priority</th>
      <th>Status</th>
      <th>Assignee</th>
      <th>Completed_at</th>
      <th>Due_date</th>
      <th>Parent_id</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
      <tr>
        <td><%= @task.title %></td>
        <td><%= @task.description %></td>
        <td><%= @task.project.name %></td>
        <td><%= @task.priority %></td>
        <td><%= @task.status %></td>
        <td><%= @task.assignee&.name %></td>
        <td><%= @task.completed_at %></td>
        <td><%= @task.due_date %></td>
        <td><%= @task.parent_id %></td>
      </tr>
  </tbody>
</table>
<h2>Comments</h2>
       <% @task.comments.each do |comment| %>
  <div class="comment">
    <p><%= comment.content %></p>  
  </div>
<% end %>
<br>
<br>
<%= button_to "Edit Task", "/api/v1/tasks/#{@task.id}/edit", method: :get,  data: { turbo: false } %>

